/dts-v1/;

#include "fsl-ls1046a.dtsi"

/ {
	model = "WatchGuard FireBox T80";
	compatible = "watchguard,firebox-t80", "fsl,ls1046a-rdb", "fsl,ls1046a";

	aliases {
		serial0 = &duart0;
		serial1 = &duart1;
		serial2 = &duart2;
		serial3 = &duart3;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};
};

&i2c0 {
  status = "okay";
  scl-gpios = <&gpio3 12 0>;

  //tpm@29 {
  //  compatible = "atmel,tpm_i2c_atmel";
  //  reg = <0x29>;
  //};
};

&i2c1 {
  status = "okay";

  // PD69104B1 PoE Controller
  poe@20 {
    compatible = "poe,poe_i2c_microsemi";
    reg = <0x20>;
  };
};

&i2c3 {
  status = "okay";

  i2c_mux@71 {
    compatible = "nxp,pca9548";
    reg = <0x71>;
    #address-cells = <1>;
    #size-cells = <0>;

    i2c@0 {
      #address-cells = <1>;
      #size-cells = <0>;
      reg = <0>;

      rtc@68 {
        compatible = "pericom,pt7c4338", "dallas,ds1307";
        reg = <0x68>;
      };
    };

    i2c@1 {
      #address-cells = <1>;
      #size-cells = <0>;
      reg = <1>;

      hwmon@2d {
        compatible = "nuvoton,nct7904";
        reg = <0x2d>;
      };
    };

		i2c@2 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <2>;

			// near RTC IC 
			exhaust_temp@4a {
				compatible = "ti,tmp175";
				reg = <0x4a>;
				sensor-name = "exhaust_temperature";
			};

			// near SSD
			intake_temp@4b {
				compatible = "ti,tmp175";
				reg = <0x4b>;
				sensor-name = "intake_temperature";
			};			
		};
  };
};

&qspi {
	status = "okay";
	bus-num = <0>;
	big-endian;

	qflash0: flash@0 {
		compatible = "mxic,mx25u3235f", "jedec,spi-nor";
		#address-cells = <1>;
		#size-cells = <1>;
		spi-max-frequency = <50000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <4>;
		reg = <0>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				reg = <0x00 0x100000>;
				label = "rcw+pbi";
				read-only;
			};

			partition@100000 {
				reg = <0x100000 0x100000>;
				label = "u-boot";
				read-only;
			};

			partition@200000 {
				reg = <0x200000 0x10000>;
				label = "empty-1";
			};

			partition@210000 {
				reg = <0x210000 0x10000>;
				label = "u-boot-env";
				read-only;
			};

			partition@220000 {
				reg = <0x220000 0x20000>;
				label = "fman ucode";
				read-only;
			};

			partition@240000 {
				reg = <0x240000 0x40000>;
				label = "empty-2-ppa";
				read-only;
			};

			partition@280000 {
				reg = <0x280000 0x20000>;
				label = "wg-cfg0";
				read-only;
			};

			partition@2a0000 {
				reg = <0x2a0000 0x20000>;
				label = "wg-cfg1";
				read-only;
			};

			partition@2c0000 {
				reg = <0x2c0000 0x20000>;
				label = "wg-mfg";
				read-only;
			};

			partition@2e0000 {
				reg = <0x2e0000 0x20000>;
				label = "empty-3";
				read-only;
			};

			partition@300000 {
				reg = <0x300000 0x20000>;
				label = "fman-ucode-old";
				read-only;
			};

			partition@320000 {
				reg = <0x320000 0xe0000>;
				label = "wg-bootopt";
				read-only;
			};
		};
	};
};

&duart0 {
	status = "okay";
};

&usb0 {
  status = "okay";
  snps,dis-u1u2-when-u3-quirk;
};

&usb1 {
  status = "okay";
  snps,dis-u1u2-when-u3-quirk;
};

&usb2 {
  status = "okay";
  snps,dis-u1u2-when-u3-quirk;
};

&pcie1 {
	status = "okay";
	num-lanes = <4>;
};

&pcie2 {
	status = "okay";
	num-lanes = <2>;
};

&pcie3 {
	status = "okay";
	num-lanes = <2>;
};

#include "fsl-ls1046-post.dtsi"

&pcsphy6 {
	compatible = "ethernet-phy-ieee802.3-c45";
	backplane-mode = "10gbase-kr";
};

&pcsphy7 {
	compatible = "ethernet-phy-ieee802.3-c45";
	backplane-mode = "10gbase-kr";
};

&fman0 {
	// backplane port 0, via pcsphy6
	sw_bp0: ethernet@f0000 {
		phy-connection-type = "sgmii-2500";
		phy-mode = "sgmii";

		fixed-link {
			speed = <2500>;
			full-duplex;
		};
	};

	// backplane port 1, via pcsphy7
	sw_bp1: ethernet@f2000 {
		phy-connection-type = "sgmii-2500";
		phy-mode = "sgmii";

		fixed-link {
			speed = <2500>;
			full-duplex;
		};
	};

	mdio@fc000 {
		switch@0 {
			compatible = "marvell,mv88e6190";
			reg = <0>;
			dsa,member = <0 0>;

			mdio {
				#address-cells = <1>;
				#size-cells = <0>;

				// ethernet-phy@0 is not used

				sw_phy1: ethernet-phy1@1{
					reg = <1>;
				};

				sw_phy2: ethernet-phy2@2{
					reg = <2>;
				};

				sw_phy3: ethernet-phy3@3{
					reg = <3>;
				};

				sw_phy4: ethernet-phy4@4{
					reg = <4>;
				};

				sw_phy5: ethernet-phy5@5{
					reg = <5>;
				};

				sw_phy6: ethernet-phy6@6{
					reg = <6>;
				};

				sw_phy7: ethernet-phy7@7{
					reg = <7>;
				};

				sw_phy8: ethernet-phy8@8{
					reg = <8>;
				};
			};

			ethernet-ports {
				#address-cells = <1>;
				#size-cells = <0>;

				// ethernet-port@0 is not used

				ethernet-port@1 {
					reg = <1>;
					label = "wan0";
					phy-handle = <&sw_phy1>;
					phy-mode = "internal";
				};

				ethernet-port@2 {
					reg = <2>;
					label = "lan1";
					phy-handle = <&sw_phy2>;
					phy-mode = "internal";
				};

				ethernet-port@3 {
					reg = <3>;
					label = "lan2";
					phy-handle = <&sw_phy3>;
					phy-mode = "internal";
				};

				ethernet-port@4 {
					reg = <4>;
					label = "lan3";
					phy-handle = <&sw_phy4>;
					phy-mode = "internal";
				};

				ethernet-port@5 {
					reg = <5>;
					label = "lan4";
					phy-handle = <&sw_phy5>;
					phy-mode = "internal";
				};

				ethernet-port@6 {
					reg = <6>;
					label = "lan5";
					phy-handle = <&sw_phy6>;
					phy-mode = "internal";
				};

				ethernet-port@7 {
					reg = <7>;
					label = "lan6";
					phy-handle = <&sw_phy7>;
					phy-mode = "internal";
				};

				ethernet-port@8 {
					reg = <8>;
					label = "lan7";
					phy-handle = <&sw_phy8>;
					phy-mode = "internal";
				};

				ethernet-port@9 {
					reg = <9>;
					label = "cpu0";
					ethernet = <&sw_bp0>;
					phy-mode = "2500base-x";

					fixed-link {
						speed = <2500>;
						full-duplex;
					};
				};

				ethernet-port@10 {
					reg = <10>;
					label = "cpu1";
					ethernet = <&sw_bp1>;
					phy-mode = "2500base-x";

					fixed-link {
						speed = <2500>;
						full-duplex;
					};
				};
			};
		};
	};
};

// WG T80 does not support secure boot, so remove OP-TEE
// not doing this will cause kernel panic at boot
/delete-node/ &{/firmware/optee};

// for some reason, usb enumeration stops working if 
// soc is marked dma-coherent
&soc {
    /delete-property/ dma-coherent;
};
